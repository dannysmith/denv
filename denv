#!/usr/bin/env bash
set -euo pipefail

DENV_IMAGE="denv-base"
DENV_DIR="$(cd "$(dirname "$(readlink "$0" || echo "$0")")" && pwd)"

die() { echo "denv: $*" >&2; exit 1; }

# Resolve project name from a path (uses the directory basename)
project_name_from_path() {
    basename "$(cd "$1" && pwd)"
}

# Get the container name for a project
container_name() {
    echo "denv-$1"
}

# Build the base image if it doesn't exist (or force rebuild)
ensure_image() {
    local force="${1:-}"
    if [ "$force" = "force" ] || ! docker image inspect "$DENV_IMAGE" &>/dev/null; then
        echo "Building $DENV_IMAGE image..."
        docker build -t "$DENV_IMAGE" "$DENV_DIR"
    fi
}

# Ensure a container exists (running or stopped), return container name
ensure_exists() {
    local project="$1"
    local container
    container="$(container_name "$project")"

    if ! docker container inspect "$container" &>/dev/null; then
        die "Container '$container' does not exist. Use 'denv create <path>' first."
    fi

    echo "$container"
}

# Create a container (docker run only, no auth). Used by create and rebuild.
create_container() {
    local project="$1"
    local path="$2"
    local container
    container="$(container_name "$project")"

    docker run -d \
        --name "$container" \
        --hostname "$project" \
        --init \
        --ipc=host \
        -e "DENV_PROJECT=$project" \
        -v "$path:/workspace" \
        --label "denv.project=$project" \
        --label "denv.path=$path" \
        --label "denv.created=$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        "$DENV_IMAGE" \
        sleep infinity >/dev/null
}

# Ensure a container exists and is running, return container name
ensure_running() {
    local container
    container="$(ensure_exists "$1")"

    if [ "$(docker inspect -f '{{.State.Running}}' "$container")" != "true" ]; then
        docker start "$container" >/dev/null
    fi

    echo "$container"
}

# --- Commands ---

cmd_create() {
    local path="${1:?Usage: denv create <path>}"
    path="$(cd "$path" && pwd)"
    local project
    project="$(project_name_from_path "$path")"
    local container
    container="$(container_name "$project")"

    if docker container inspect "$container" &>/dev/null; then
        die "Container '$container' already exists. Use 'denv shell $project' to connect."
    fi

    ensure_image

    echo "Creating container '$container' for $path..."
    create_container "$project" "$path"

    # --- GitHub auth (device code flow works via docker exec) ---
    echo ""
    echo "=== GitHub Authentication ==="
    echo "Follow the prompts to authenticate with GitHub."
    echo ""
    docker exec -it "$container" gh auth login \
        --hostname github.com \
        --git-protocol https \
        --web \
        --skip-ssh-key

    echo ""
    echo "Container '$container' created. To finish setup:"
    echo ""
    echo "  1. denv $project"
    echo "  2. claude              (then /login to authenticate)"
    echo "  3. /opt/denv/install-claude-plugins.sh"
}

cmd_shell() {
    local project="${1:?Usage: denv shell <project>}"
    local container
    container="$(ensure_running "$project")"

    docker exec -it -e "DENV_PROJECT=$project" "$container" zsh
}

cmd_claude() {
    local project="${1:?Usage: denv claude <project>}"
    shift
    local container
    container="$(ensure_running "$project")"

    docker exec -it -e "DENV_PROJECT=$project" "$container" claude "$@"
}

cmd_update_plugins() {
    local project="${1:?Usage: denv update-plugins <project>}"
    local container
    container="$(ensure_running "$project")"

    # Copy latest script from repo into container
    docker cp "$DENV_DIR/scripts/install-claude-plugins.sh" \
        "$container:/opt/denv/install-claude-plugins.sh"

    docker exec "$container" /opt/denv/install-claude-plugins.sh
}

cmd_start() {
    local project="${1:?Usage: denv start <project>}"
    local container
    container="$(ensure_exists "$project")"

    if [ "$(docker inspect -f '{{.State.Running}}' "$container")" = "true" ]; then
        echo "Container '$container' is already running."
    else
        docker start "$container" >/dev/null
        echo "Started '$container'."
    fi
}

cmd_stop() {
    local project="${1:?Usage: denv stop <project>}"
    local container
    container="$(ensure_exists "$project")"

    if [ "$(docker inspect -f '{{.State.Running}}' "$container")" != "true" ]; then
        echo "Container '$container' is already stopped."
    else
        docker stop "$container" >/dev/null
        echo "Stopped '$container'."
    fi
}

cmd_rm() {
    local project="${1:?Usage: denv rm <project>}"
    local container
    container="$(ensure_exists "$project")"

    docker rm -f "$container" >/dev/null
    echo "Removed '$container'."
}

cmd_rebuild() {
    local project="${1:-}"

    ensure_image force

    if [ -z "$project" ]; then
        echo "Image rebuilt. Run 'denv rebuild <project>' to recreate a container."
        return
    fi

    local container
    container="$(container_name "$project")"

    if ! docker container inspect "$container" &>/dev/null; then
        die "Container '$container' does not exist. Nothing to recreate."
    fi

    # Read the project path from the container's labels
    local path
    path="$(docker inspect -f '{{index .Config.Labels "denv.path"}}' "$container")"

    if [ -z "$path" ]; then
        die "Could not read project path from container labels."
    fi

    echo "Removing old container '$container'..."
    docker rm -f "$container" >/dev/null

    echo "Creating new container '$container' for $path..."
    create_container "$project" "$path"

    echo ""
    echo "Container '$container' recreated from new image."
    echo "Auth state was reset. To re-authenticate:"
    echo ""
    echo "  1. denv $project"
    echo "  2. gh auth login --hostname github.com --git-protocol https --web --skip-ssh-key"
    echo "  3. claude              (then /login to authenticate)"
    echo "  4. /opt/denv/install-claude-plugins.sh"
}

cmd_ls() {
    local format='{{.Label "denv.project"}}\t{{.State}}\t{{.Label "denv.path"}}'
    local output
    output="$(docker ps -a --filter label=denv.project --format "$format" 2>/dev/null)"

    if [ -z "$output" ]; then
        echo "No denv containers found."
        return
    fi

    printf "%-20s %-10s %s\n" "PROJECT" "STATUS" "PATH"
    echo "$output" | while IFS=$'\t' read -r name state path; do
        case "$state" in
            running) status="running" ;;
            *)       status="stopped" ;;
        esac
        printf "%-20s %-10s %s\n" "$name" "$status" "$path"
    done
}

cmd_scaffold() {
    local name="${1:?Usage: denv scaffold <name> [path]}"
    local base="${2:-$HOME/dev}"
    local target="$base/$name"

    if [ -d "$target" ]; then
        die "Directory '$target' already exists."
    fi

    echo "Scaffolding project '$name' at $target..."
    mkdir -p "$target"
    cp -r "$DENV_DIR/scaffold/." "$target/"

    # Replace placeholder in README
    sed -i '' "s/__PROJECT_NAME__/$name/g" "$target/README.md"

    # Initialize git repo
    git -C "$target" init -q
    git -C "$target" add -A
    git -C "$target" commit -q -m "Initial scaffold"

    echo "Project scaffolded. Creating container..."
    cmd_create "$target"
}

# --- Main ---

cmd="${1:-}"
shift 2>/dev/null || true

case "$cmd" in
    create)          cmd_create "$@" ;;
    shell)           cmd_shell "$@" ;;
    claude)          cmd_claude "$@" ;;
    start)           cmd_start "$@" ;;
    stop)            cmd_stop "$@" ;;
    rm)              cmd_rm "$@" ;;
    rebuild)         cmd_rebuild "$@" ;;
    ls)              cmd_ls ;;
    scaffold)        cmd_scaffold "$@" ;;
    update-plugins)  cmd_update_plugins "$@" ;;
    "")              die "Usage: denv <command> [args]

Commands:
  create <path>            Create a container for a project
  shell <project>          Open a shell in a container
  claude <project> [args]  Start Claude Code in a container
  start <project>          Start a stopped container
  stop <project>           Stop a running container
  rm <project>             Remove a container
  rebuild [project]        Rebuild image; if project given, recreate container
  ls                       List all denv containers
  scaffold <name> [path]   Create a new project with templates and container
  update-plugins <project> Update Claude plugins from latest script" ;;
    *)               cmd_shell "$cmd" "$@" ;;  # denv <project> is shortcut for denv shell <project>
esac
