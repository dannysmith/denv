{
  "permissions": {
    "allow": [
      "Read(*)",
      "Edit(*)",
      "Write(*)",
      "Glob(*)",
      "Grep(*)",
      "Bash(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "mcp__context7__*",
      "mcp__playwright__*",
      "Skill(css-expert:*)",
      "Skill(frontend-design:*)",
      "Skill(playwright-cli:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/denv/hooks/gate-writes.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "css-expert@dannysmith": true,
    "frontend-design@claude-plugins-official": true,
    "playwright-cli@playwright-cli": true
  },
  "alwaysThinkingEnabled": true
}
